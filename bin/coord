#!/usr/bin/env node
'use strict';
const path = require('path'), fs = require('fs');
const L = require('./lib.js'), R = require('./rules.js'), A = require('./archive.js'), O = require('./onboard.js'), D = require('./devsetup.js');
const { P } = L;

const argv = process.argv.slice(2);
const cmd = argv.shift();
const flags = {}, rest = [];
for (let i = 0; i < argv.length; i++) {
  if (argv[i].startsWith('--')) {
    const [k, v] = argv[i].slice(2).split('=');
    flags[k] = v !== undefined ? v : (argv[i + 1] && !argv[i + 1].startsWith('--') ? argv[++i] : true);
  } else rest.push(argv[i]);
}
const list = v => (typeof v === 'string' ? v.split(',').map(s => s.trim()).filter(Boolean) : []);
const die = m => { console.error(m); process.exit(1); };
const need = (...ks) => ks.forEach(k => { if (typeof flags[k] !== 'string') die(`missing --${k}`); });

const USAGE = `coord — jetKreate cross-repo coordination

  list [--status X]              tickets, newest first
  show <id>                      a ticket or decision in full
  new --from R --to R --title T [--request --reason --files --acceptance --test]
  approve <id> [note]            open -> approved        (human)
  start <id> [note]              approved -> in_progress (assignee)
  review <id> [note]             in_progress -> review   (assignee; Test steps required)
  done <id> [note]               review -> done          (human)
  reject <id> <reason>           -> rejected             (human)
  decide --title T --repos a,b --tickets T-001 [--context --options --decision --reason --consequences]
  supersede <old-id> <new-id>
  why <file>:<line>              which ticket and decisions explain this line
  search <text>                  tickets, decisions, archive indexes
  archive [--dry-run]
  check                          validate formats, ownership, transitions, links, registry
  drill                          end-to-end self-test in a temp folder

  repos                          onboarded / discovered / offboarded
  onboard <repo> --preflight     read-only report: validation, stack, setup, candidates
  onboard <repo> --apply         registry + status file + .git/info/exclude + snapshots
         [--stack S --contracts a,b --depends-on c,d]
  offboard <repo> --yes          mark offboarded, archive its status file and tickets

  on [<id>|--clear]              show or set the ticket this repo's commits get tagged with
  who [--tool T] [--name N]      the roster: who is on the team, what they use, where they were
      [--remove <name>]          drop someone who has left
  setup [--yes] [--no-path]      FIRST RUN AFTER CLONING: does all of the below, asking
                                 only where it cannot tell (cloning repos, editing ~/.zshrc)
  sync [--quiet]                 pull and push the board (needs a remote on .coord)
  devsetup [--repo R] [--strict] [--no-copilot]
                                 install this machine's git hooks + editor instructions
`;

const CMDS = {
  list() {
    const want = flags.status;
    const rows = L.lsMd(P.tickets).map(f => L.parse(L.read(path.join(P.tickets, f))).fm)
      .filter(fm => !want || fm.status === want)
      .sort((a, b) => String(b.updated).localeCompare(String(a.updated)));
    if (!rows.length) return console.log(want ? `no tickets with status ${want}` : 'no open tickets');
    for (const fm of rows) console.log(`${fm.id}  ${fm.status.padEnd(11)}  ${fm.from} -> ${fm.to}  ${fm.title}`);
  },

  show() {
    const id = (rest[0] || die('usage: coord show <id>')).toUpperCase();
    const f = /^D-/i.test(id) ? L.findDecision(id) : L.findTicket(id);
    if (f) {
      console.log(`# ${path.relative(P.coord, f)}\n`);
      return console.log(L.read(f));
    }
    // No ticket file. The id may still be one of the JET-nnn tags already in the code —
    // show where it is cited rather than claiming it does not exist.
    if (new RegExp(`^${L.TICKET_PREFIX}-\\d+$`).test(id)) {
      const refs = L.codeRefs(id);
      if (refs.length) {
        console.log(`${id}  —  no ticket file; ${refs.length} reference(s) in code\n`);
        let repo = null;
        for (const r of refs.slice(0, 25)) {
          if (r.repo !== repo) { console.log(`  ${r.repo}`); repo = r.repo; }
          console.log(`    ${r.file}:${r.line}`);
          if (r.text) console.log(`      ${r.text.slice(0, 100)}`);
        }
        if (refs.length > 25) console.log(`    ...and ${refs.length - 25} more`);
        console.log(`\nNothing records why. To give it a home: coord new --from <repo> --to <repo> --title "..."`);
        return;
      }
    }
    die(`not found: ${id}`);
  },

  new() {
    need('from', 'to', 'title');
    const repos = L.onboarded();
    for (const k of ['from', 'to']) if (!repos.includes(flags[k]) && flags[k] !== 'human') {
      const d = L.discovered().includes(flags[k]) ? ` — it is discovered but not onboarded; run: coord onboard ${flags[k]} --preflight` : '';
      die(`--${k} "${flags[k]}" is not an onboarded repo (have: ${repos.join(', ') || 'none'})${d}`);
    }
    const r = R.newTicket({
      from: flags.from, to: flags.to, title: flags.title,
      request: flags.request, reason: flags.reason, files: flags.files,
      acceptance: flags.acceptance, test: flags.test,
    });
    console.log(`${r.id} created (open) -> ${path.relative(P.coord, r.file)}`);
    const filer = L.me();
    console.log(filer
      ? `Tell ${filer}; it does nothing until they run: coord approve ${r.id}`
      : `Tell whoever asked for this; it does nothing until they run: coord approve ${r.id}`);
  },

  on() {
    const repo = L.repoOf(process.cwd());
    if (!repo) die('run this from inside a repo');
    if (flags.clear) { L.setCurrentTicket(repo, ''); return console.log(`${repo}: commits are no longer tagged`); }
    const id = (rest[0] || '').toUpperCase();
    if (!id) {
      const cur = L.currentTicket(repo);
      return console.log(cur ? `${repo} is on ${cur} — commits here are tagged "${cur}: ..."` : `${repo} has no current ticket; commits are left as you type them`);
    }
    const t = L.loadTicket(id);
    if (!t) die(`no such ticket: ${id}`);
    L.setCurrentTicket(repo, t.fm.id);
    console.log(`${repo} is on ${t.fm.id} — commits here are tagged automatically now`);
  },

  approve: () => move('approved'),
  start: () => move('in_progress'),
  review: () => move('review'),
  done: () => move('done'),
  reject() {
    const id = (rest.shift() || '').toUpperCase() || die('usage: coord reject <id> <reason>');
    const why = rest.join(' ') || die('a reason is required');
    const t = R.transition(id, 'rejected', why);
    console.log(`${id}: ${t.from} -> rejected`);
  },

  decide() {
    need('title');
    const tickets = list(flags.tickets);
    for (const t of tickets) if (!L.loadTicket(t)) die(`no such ticket: ${t}`);
    const r = R.newDecision({
      title: flags.title, repos: list(flags.repos), tickets,
      context: flags.context, options: flags.options, decision: flags.decision,
      reason: flags.reason, consequences: flags.consequences,
    });
    console.log(`${r.id} recorded -> ${path.relative(P.coord, r.file)}`);
    if (tickets.length) console.log(`linked to ${tickets.join(', ')}`);
  },

  supersede() {
    const [o, n] = rest.map(s => (s || '').toUpperCase());
    if (!o || !n) die('usage: coord supersede <old-id> <new-id>');
    R.supersede(o, n);
    console.log(`${o} superseded by ${n}`);
  },

  why() {
    const arg = rest[0] || die('usage: coord why <file>:<line>');
    const m = /^(.*):(\d+)$/.exec(arg) || die('usage: coord why <file>:<line>');
    const [, fileArg, lineNo] = m;
    if (!L.exists(path.resolve(fileArg))) die(`no such file: ${fileArg}`);
    const abs = L.real(path.resolve(fileArg));
    const repo = L.repoOf(path.dirname(abs));
    if (!repo) die(`${fileArg} is not inside a platform repo`);
    const repoDir = L.real(path.join(P.root, repo));
    const blame = L.sh('git', ['blame', '-L', `${lineNo},${lineNo}`, '--porcelain', '--', path.relative(repoDir, abs)], repoDir);
    if (!blame.ok) die(`git blame failed in ${repo}: ${blame.err.split('\n')[0]}`);
    const sha = blame.out.split(' ')[0];
    const log = L.sh('git', ['log', '-1', '--format=%h%n%an%n%ad%n%s%n%b', '--date=short', sha], repoDir);
    const [short, author, date, subject, ...bodyLines] = log.out.split('\n');
    console.log(`${repo}/${path.relative(repoDir, abs)}:${lineNo}`);
    console.log(`commit ${short}  ${author}  ${date}`);
    console.log(`  ${subject}\n`);

    const ids = [...new Set([subject, ...bodyLines].join('\n').match(new RegExp(L.TICKET_RE.source, 'g')) || [])];
    if (!ids.length) {
      if (/^no-ticket:/i.test(subject)) return console.log(`No ticket: the commit says "${subject}".`);
      // No ID in the message — fall back to what was live for this repo at that moment.
      const at = L.sh('git', ['log', '-1', '--format=%aI', sha], repoDir).out;
      const live = R.ticketsActiveAt(repo, at);
      if (!live.length) return console.log('No ticket ID in that commit, and nothing was open for this repo at the time.');
      console.log(`No ticket ID in that commit. Open around ${String(at).slice(0, 10)} — a guess from timing, not a recorded link:\n`);
      for (const { fm, state, role } of live) console.log(`  ${fm.id} [${state}] ${fm.title}\n      ${fm.from} -> ${fm.to} · ${role}`);
      console.log(`\nRun "coord show <id>" for the full story.`);
      return;
    }
    for (const id of ids) {
      const t = L.loadTicket(id);
      if (!t) { console.log(`${id}: referenced by the commit, but no such ticket (active or archived).`); continue; }
      console.log(`${id} [${t.fm.status}]${t.archived ? ' (archived)' : ''}  ${t.fm.from} -> ${t.fm.to}  ${t.fm.title}`);
      console.log(`  Request: ${(t.sec.Request || '—').trim()}`);
      const thread = (t.sec.Thread || '').trim();
      if (thread) console.log(thread.split('\n').map(l => '  | ' + l).join('\n'));
      for (const d of t.fm.decisions || []) {
        const df = L.findDecision(d);
        if (!df) { console.log(`  ${d}: linked but missing`); continue; }
        const { fm, body } = L.parse(L.read(df));
        console.log(`  ${d} [${fm.status}${fm.superseded_by ? ' by ' + fm.superseded_by : ''}] ${fm.title}`);
        console.log(`    ${(L.sections(body).Decision || '—').trim().split('\n')[0]}`);
      }
      console.log('');
    }
  },

  search() {
    const q = rest.join(' ').toLowerCase() || die('usage: coord search <text>');
    const targets = [
      ...L.idDirs(L.TICKET_PREFIX).flatMap(d => L.lsMd(d).map(f => path.join(d, f))),
      ...L.lsMd(P.decisions).map(f => path.join(P.decisions, f)),
      path.join(P.archive, 'tickets-index.md'),
      ...L.ls(path.join(P.archive, 'activity')).filter(f => f.endsWith('-summary.md')).map(f => path.join(P.archive, 'activity', f)),
    ].filter(L.exists);
    let n = 0;
    for (const f of targets) {
      const hits = L.read(f).split('\n').map((l, i) => [i + 1, l]).filter(([, l]) => l.toLowerCase().includes(q));
      if (!hits.length) continue;
      console.log(path.relative(P.coord, f));
      for (const [i, l] of hits.slice(0, 5)) console.log(`  ${i}: ${l.trim()}`);
      n += hits.length;
    }
    if (!n) console.log(`nothing matches "${rest.join(' ')}"`);
  },

  archive() {
    const acts = A.archive({ dryRun: !!flags['dry-run'] });
    console.log(acts.length ? acts.join('\n') : 'nothing to archive');
    if (flags['dry-run']) console.log('(dry run — nothing was moved)');
  },

  check() {
    const probs = R.check();
    const real = probs.filter(p => p.level !== 'info');
    if (!real.length) console.log('check: OK');
    for (const p of real) console.log(`${p.level.toUpperCase()}  ${p.where}: ${p.msg}`);
    for (const p of probs.filter(p => p.level === 'info')) console.log(`note: ${p.msg}`);
    if (probs.some(p => p.level === 'error')) process.exit(1);
  },

  who() {
    if (typeof flags.remove === 'string') {
      if (!L.isHuman()) die(`removing someone from the roster is the human's call.`);
      const gone = L.people().find(p => p.name === flags.remove);
      if (!gone) die(`nobody on the roster is called "${flags.remove}"`);
      L.writePeople(L.people().filter(p => p.name !== flags.remove));
      return console.log(`removed ${gone.name} from the roster`);
    }
    if (typeof flags.tool === 'string' || typeof flags.name === 'string') {
      const mine = L.people().find(p => p.name === L.me());
      if (!mine) die('you are not on the roster yet — run: coord setup');
      if (typeof flags.tool === 'string' && !L.TOOLS.includes(flags.tool)) die(`--tool must be one of: ${L.TOOLS.join(', ')}`);
      const updated = L.putPerson({
        ...mine,
        ...(typeof flags.name === 'string' ? { name: flags.name } : {}),
        ...(typeof flags.tool === 'string' ? { tool: flags.tool } : {}),
      });
      return console.log(`${updated.name} — ${updated.tool}`);
    }
    const all = L.whosAround();
    if (!all.length) return console.log('nobody on the roster yet — run: coord setup');
    const you = L.me();
    for (const p of all) {
      const where = p.repo ? `${p.repo}  ${p.ts.slice(0, 16).replace('T', ' ')}` : 'no activity yet';
      console.log(`  ${(p.name + (p.name === you ? ' (you)' : '')).padEnd(22)} ${String(p.tool).padEnd(12)} ${where}`);
    }
  },

  repos() {
    const reg = L.registry();
    const active = reg.filter(r => r.status === 'active');
    console.log(`onboarded (${active.length})`);
    for (const r of active) console.log(`  ${r.name.padEnd(24)} ${r.stack || '—'}${(r.depends_on || []).length ? `  -> ${r.depends_on.join(', ')}` : ''}${(r.contracts || []).length ? `  owns ${r.contracts.join(', ')}` : ''}`);
    const disc = L.discovered();
    console.log(`\ndiscovered, not onboarded (${disc.length})`);
    for (const r of disc) console.log(`  ${r.padEnd(24)} run: coord onboard ${r} --preflight`);
    const off = reg.filter(r => r.status === 'offboarded');
    console.log(`\noffboarded (${off.length})`);
    for (const r of off) console.log(`  ${r.name.padEnd(24)} since ${r.offboarded || '?'} (history kept in archive/)`);
  },

  onboard() {
    const name = rest[0] || die('usage: coord onboard <repo> --preflight | --apply');
    if (flags.apply) {
      const done = O.apply(name, {
        stack: typeof flags.stack === 'string' ? flags.stack : undefined,
        contracts: list(flags.contracts),
        depends_on: list(flags['depends-on']),
      });
      console.log(done.map(d => '  ' + d).join('\n'));
      console.log(`\n${name} is onboarded. Remaining runbook steps: contract stubs, decision record, coord check.`);
      return;
    }
    printPreflight(O.detect(name));
  },

  offboard() {
    const name = rest[0] || die('usage: coord offboard <repo> --yes');
    if (!L.isHuman()) die(`offboarding ${name} is the human's call. Ask them to run: coord offboard ${name} --yes`);
    if (!flags.yes) die(`this archives ${name}'s status file and tickets (decisions stay). Re-run with --yes to confirm.`);
    console.log(O.offboard(name).map(d => '  ' + d).join('\n'));
  },

  sync() {
    const quiet = !!flags.quiet;
    const say = m => { if (!quiet) console.log(m); };
    if (!L.coordGit(['remote']).out) {
      if (quiet) return;
      die('.coord has no remote, so there is nothing to sync with.\n' +
          'Add one:  git -C ' + L.P.coord + ' remote add origin <url> && coord sync');
    }
    if (L.snapshot('coord: local changes before sync')) say('committed local changes');

    const f = L.coordGit(['fetch', '--quiet', 'origin']);
    if (!f.ok) { if (quiet) return; die(`fetch failed: ${f.err.split('\n')[0]}`); }

    const branch = L.coordGit(['rev-parse', '--abbrev-ref', 'HEAD']).out || 'main';
    const upstream = L.coordGit(['rev-parse', '--verify', '--quiet', `origin/${branch}`]).ok;
    if (upstream) {                                  // nothing to rebase onto on a fresh remote
      const pull = L.coordGit(['rebase', `origin/${branch}`]);
      if (!pull.ok) {
        L.coordGit(['rebase', '--abort']);
        if (quiet) return;
        die(`cannot rebase onto origin/${branch} — someone changed the same file.\n` +
            `Resolve by hand in ${L.P.coord}:  git pull --rebase  then  coord check`);
      }
    } else say(`origin/${branch} does not exist yet — publishing the board for the first time`);

    const push = L.coordGit(['push', '-u', 'origin', branch]);
    if (!push.ok) { if (quiet) return; die(`push failed: ${push.err.split('\n')[0]}`); }

    const n = L.coordGit(['rev-list', '--count', `origin/${branch}..${branch}`]).out;
    say(`synced with origin/${branch}${n && n !== '0' ? ` (${n} ahead)` : ''}`);
    const probs = R.check().filter(p => p.level === 'error');
    if (probs.length) say(`heads up: coord check reports ${probs.length} problem(s) after the merge`);
  },

  setup() {
    require('./setup.js').setup({ yes: !!flags.yes, noPath: !!flags['no-path'] });
  },

  devsetup() {
    const out = D.devsetup({
      repo: typeof flags.repo === 'string' ? flags.repo : undefined,
      strict: !!flags.strict,
      copilot: flags['no-copilot'] !== true,
    });
    console.log(out.map(l => '  ' + l).join('\n'));
    console.log(`\nGit hooks are local to each clone and never committed.`);
    console.log(`The .github/copilot-instructions.md files ARE tracked — review the diffs and commit them.`);
  },

  'log-commit'() {                               // called by the post-commit hook
    const r = D.logCommit(process.cwd());
    if (r) console.log(r);
  },

  drill: () => require('./drill.js').run(),
  help: () => console.log(USAGE),
};

function printPreflight(r) {
  const yn = b => (b ? 'yes' : 'NO');
  const bad = O.failures(r);
  console.log(`# Preflight — ${r.name}\n`);
  console.log(`path: ${r.abs}`);
  for (const [k, v] of Object.entries(r.valid)) console.log(`  [${v ? 'x' : ' '}] ${k}`);
  console.log(`\n## Git`);
  console.log(`  branch: ${r.git.branch}\n  remote: ${r.git.remote}\n  uncommitted: ${r.git.dirtyCount}${r.git.dirtyCount ? ' — ' + r.git.dirtyFiles.slice(0, 5).join(' | ') : ''}`);
  const s = r.stack;
  console.log(`\n## Stack`);
  console.log(`  summary: ${s.summary}`);
  console.log(`  package manager: ${s.manager} (${s.lockfile})${s.monorepo ? ' — monorepo' : ''}`);
  console.log(`  node pinning: ${s.nodePin.join(' | ') || 'none'}`);
  console.log(`  typescript: ${yn(s.typescript)}   package name: ${s.pkgName || '—'}`);
  console.log(`  frameworks: ${s.frameworks.join(', ') || 'none detected'}`);
  for (const [k, v] of Object.entries(s.scripts)) console.log(`  ${k} scripts: ${v.join(', ') || '—'}`);
  console.log(`\n## Existing Claude setup`);
  for (const [k, v] of Object.entries(r.claude)) console.log(`  ${k}: ${yn(v)}`);
  console.log(`\n## Candidate contracts (${r.contracts.length}) — scanned ${r.files} files`);
  if (!r.contracts.length) console.log('  none detected — this repo may not expose an API');
  for (const c of r.contracts) console.log(`  ${c.group}  [${c.confidence}]  ${c.pathCount} route(s)  e.g. ${c.paths.slice(0, 3).join(' ')}  (${c.evidence[0]})`);
  console.log(`\n## Candidate depends_on (${r.depends_on.length})`);
  if (!r.depends_on.length) console.log('  none detected');
  for (const d of r.depends_on) console.log(`  ${d.repo}  [${d.confidence}]  ${d.evidence.join('; ')}`);
  console.log(`\n## Planned changes (apply does nothing until you run --apply)`);
  console.log(`  create  .coord/status/${r.name}.md`);
  console.log(`  modify  .coord/repos.json`);
  console.log(`  modify  ${r.name}/.git/info/exclude  ${r.excludes.length ? '(+ ' + r.excludes.join(', ') + ')' : '(already covered)'}`);
  console.log(`  create  .coord/contracts/*.md stubs for confirmed contracts`);
  console.log(`  create  .coord/decisions/D-xxx-onboarded-${r.name}.md`);
  console.log(`\nvalidation: ${bad.length ? 'FAILED — ' + bad.join('; ') : 'passed'}`);
}

function move(to) {
  const id = (rest.shift() || '').toUpperCase() || die(`usage: coord ${to === 'approved' ? 'approve' : to} <id> [note]`);
  const t = R.transition(id, to, rest.join(' '));
  console.log(`${id}: ${t.from} -> ${to}`);
  if (t.onBehalf) console.log(`note: filed by ${t.onBehalf} — recorded as done by ${L.me() || 'you'}`);
  if (to === 'approved') console.log(`${id} is open to any of us now: coord start ${id}`);

  // starting work points the repo at the ticket; every commit then tags itself
  const tk = L.loadTicket(id);
  if (to === 'in_progress' && tk && L.setCurrentTicket(tk.fm.to, id)) {
    console.log(`commits in ${tk.fm.to} are now tagged "${id}: ..." — you do not need to type it`);
  }
  if (['done', 'rejected'].includes(to) && tk && L.currentTicket(tk.fm.to) === id) {
    L.setCurrentTicket(tk.fm.to, '');
    console.log(`commits in ${tk.fm.to} are no longer tagged`);
  }
}

try {
  L.ensureStatusFiles();                       // a new repo gets a status file on any CLI use
  (CMDS[cmd] || CMDS.help)();
} catch (e) {
  die(e.message);
}
